{
  "name": "ahvantir-website",
  "version": "1.0.0",
  "description": "The Ahvantir lore encyclopedia \u2014 a living reference for the Aru'Mas campaign setting",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "build:prod": "eleventy && pagefind --site _site",
    "start": "eleventy --serve",
    "dev": "eleventy --serve --incremental",
    "sync": "python3 scripts/obsidian-to-md.py",
    "test": "npm run test:coords && npm run test:callouts && npm run test:contrast",
    "test:coords": "node scripts/test-map-coords.js",
    "test:callouts": "python3 scripts/test-sync-callouts.py",
    "test:contrast": "node scripts/test-contrast.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "pagefind": "^1.1.0"
  }
}
