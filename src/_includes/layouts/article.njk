---
layout: base
---
{% set toc = content | tableOfContents %}
<article class="article"
  data-pagefind-body
  {% if category %}data-pagefind-filter="category:{{ category | capitalize }}"{% endif %}>
  {# Pagefind metadata — each key needs its own element; duplicate attrs on one element are dropped by the HTML parser #}
  <span hidden data-pagefind-meta="title:{{ title }}"></span>
  {% if tags %}<span hidden data-pagefind-meta="tags:{{ tags | join(', ') }}"></span>{% endif %}

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">›</span>
    <a href="/articles/">Articles</a>
    {% if category %}
    <span aria-hidden="true">›</span>
    <a href="/articles/#{{ category }}">{{ category | capitalize }}</a>
    {% endif %}
  </nav>

  <header class="article-header">
    {% if dm_only %}
    <div class="dm-only-banner" aria-label="DM only content">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      This article contains DM-only information
    </div>
    {% endif %}

    <h1 class="article-title">{{ title }}</h1>

    {% if description %}
    {# stripWikilinks, like every other consumer of description. Without it the
       site-wide wikilink transform expands a [[Target]] here AFTER the value has
       been HTML-escaped, so [[Aru'Mas]] slugified through its escaped apostrophe
       into a link to /articles/aru-39-mas/ with the text Aru&#39;Mas. #}
    <p class="article-lead">{{ description | stripWikilinks }}</p>
    {% endif %}

    {# One row of metadata: what kind of article this is, when it happened, and
       the tags. The tags used to be printed here AND again in a sidebar card,
       so every article listed them twice on one screen. They belong with the
       title, which is where a reader looks to find out what a page is. #}
    <div class="article-meta">
      {% if category %}
      <a href="/articles/#{{ category }}" class="category-badge">{{ category | capitalize }}</a>
      {% endif %}
      {% if timeline_date %}
      <span class="meta-date">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        {{ timeline_date }}
      </span>
      {% endif %}
      {% if tags and tags.length %}
      <div class="article-tags" aria-label="Tags">
        {% for tag in tags %}
        <a href="/articles/#tag-{{ tag | toSlug }}" class="tag" data-tag="{{ tag | toSlug }}">{{ tag }}</a>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </header>

  <div class="article-layout">
    <div class="article-body">
      {# Drops the `# Title` every article opens with. See dropLeadingTitle in
         .eleventy.js: the layout prints the title already, so without this the
         name appeared twice and the page carried two <h1> elements. #}
      {{ content | dropLeadingTitle(title) | safe }}
    </div>

    <aside class="article-sidebar" aria-label="Article sidebar">

      {# Articles here run to thousands of words with a dozen sections and no
         way to see their shape. Built from the rendered headings at build
         time, so it cannot drift from the page. Four is the floor: below that
         the whole article is already on screen and a contents list is noise. #}
      {% if toc.length >= 4 %}
      <nav class="sidebar-section toc" aria-labelledby="toc-title">
        <h2 class="sidebar-title" id="toc-title">Contents</h2>
        <ul class="toc__list" role="list">
          {% for h in toc %}
          <li class="toc__item toc__item--h{{ h.level }}">
            <a href="#{{ h.id }}">{{ h.text }}</a>
          </li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}

      {% if backlinks and backlinks.length %}
      {# Aru'Mas has thirty-odd of these and they used to run down the page
         unbroken, making the sidebar longer than most articles. Eight, then
         the rest behind a disclosure -- <details> rather than script, so it
         works before any JavaScript runs and prints open. #}
      <section class="sidebar-section" data-backlinks>
        <h2 class="sidebar-title">Mentioned in <span class="sidebar-count">{{ backlinks.length }}</span></h2>
        <ul class="backlinks-list" role="list">
          {% for link in backlinks | take(8) %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
        {% if backlinks.length > 8 %}
        <details class="sidebar-more">
          <summary>Show {{ backlinks.length - 8 }} more</summary>
          <ul class="backlinks-list" role="list">
            {% for link in backlinks | drop(8) %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </details>
        {% endif %}
      </section>
      {% endif %}

      {# Character lore links — populated client-side by article-links.js #}
      <section class="sidebar-section" id="char-links-section" hidden>
        <h2 class="sidebar-title">Linked characters</h2>
        <ul class="backlinks-list" role="list" id="char-links-list"></ul>
      </section>

      {% if related and related.length %}
      <section class="sidebar-section">
        <h2 class="sidebar-title">Related</h2>
        <ul class="related-list" role="list">
          {% for rel in related %}
          <li><a href="{{ rel | articleUrl }}">{{ rel }}</a></li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

    </aside>
  </div>

  <a href="/articles/" class="back-link">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    All articles
  </a>

</article>

{% block scripts %}
<script src="/assets/js/article-links.js" defer></script>
{% endblock %}
