---
layout: base
title: Maps
description: "Interactive maps of Ahvantir and the city of Aru'Mas."
permalink: /map/
---

<div class="page-header">
  <div class="container">
    <h1 class="page-title">Maps</h1>
    <p class="page-lead">Hover a marker for a summary. Click to open its article.</p>
  </div>
</div>

<div class="map-page">
  <div class="map-main">
    <div class="map-toolbar" id="map-toolbar" hidden>
      <label class="map-switch">
        <span class="map-switch__label">Map</span>
        <select id="map-select" class="map-switch__select" aria-label="Choose a map"></select>
      </label>
      <div class="map-toggles" id="map-toggles" role="group" aria-label="Layer visibility"></div>
    </div>

    <div class="map-canvas" id="map-canvas" aria-label="Interactive map"></div>

    <div class="map-status" id="map-status" role="status">
      <div class="map-status__inner">
        <span class="map-status__icon" aria-hidden="true">🗺</span>
        <p class="map-status__title">Loading maps…</p>
      </div>
    </div>
  </div>

  <aside class="map-sidebar">
    <h2 class="sidebar-title" id="map-sidebar-title">Locations</h2>
    <p class="map-sidebar__hint" id="map-sidebar-hint">Select a map to see what has been marked on it.</p>
    <div class="map-marker-list" id="map-marker-list"></div>
  </aside>
</div>

{% block scripts %}
{# Leaflet and Geoman both come from jsdelivr: it is the only CDN the
   Content-Security-Policy in base.njk allows for scripts and styles. #}
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H"
      crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH"
        crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.108.1/dist/umd/supabase.min.js" integrity="sha384-UQ9Ztz63gzT2JZCuDRkNXV8RP/gXxdPUuM9LKlz2BzqGx9xFYNAK8yAEgbfZHs7P" crossorigin="anonymous"></script>
<script src="/assets/js/auth-storage.js"></script>
<script src="/assets/js/player.js"></script>
<script src="/assets/js/map-coords.js"></script>
<script src="/assets/js/map.js"></script>
{# Inert for visitors: it checks is_dm() first and only then fetches the
   drawing library, so a reader never downloads the editor's 290 KB. #}
<script src="/assets/js/map-editor.js"></script>
{% endblock %}
